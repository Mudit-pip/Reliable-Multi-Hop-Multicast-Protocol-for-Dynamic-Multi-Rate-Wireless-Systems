        + (q2 - corr_ab - corr_bc + corr_abc)*(n2+two56+etta+ettd)
        + (q1 - corr_ab - corr_ac + corr_abc)*(n2+ettd + zeroto56)

        + (corr_bc - corr_abc)*(n2+etta + ettd + min({two56,three56,ettf+etti,ettg+etth}))
        + (corr_ab - corr_abc)*(n2 + ettd + two56)
        + (corr_ac - corr_abc)*(n2 + ettd + three56)

        + (corr_abc)*(n2 + ettd + min({two56,three56,ettf+etti,ettg+etth,ette+ettg,etti+ette}));

    // success = at least one of {2,3}
    float denominator = q1 + q2 + q3 - corr_ab - corr_bc - corr_ac + corr_abc;


    return numerator / denominator;
}


// ETX from 0 → {4,5,6}
void ETX_0_to_456_3intermediate(
    float a, float al, float b, float bl, float c, float cl, 
    float d, float dl, float e, float el, float f, float fl,  
    float g, float gl, float h, float hl, float i, float il,
    float corr_ab,float corr_bc,float corr_ac,float corr_abc,
    float corr_de, float corr_fg,float corr_hi) {

    vector<vector<float>> cost(7, vector<float>(3, 0));

///////////////////////////////////////////////////
    cost[0][0] = b/bl + g/gl;
    cost[1][0] = ETX_1dest12(a,al,b,bl,e,el,f,fl,corr_ab);
    cost[2][0] = ETX_2dest12(a,al,b,bl,e,el,f,fl,g,gl, corr_ab, corr_fg);
    cost[3][0] = (a/al)+(d/dl);
    cost[4][0] = ETX_2dest13(a,d,b,g,al,dl,bl,gl, corr_ab);
    cost[5][0] = ETX_2dest12(b,bl,a,al,f,fl,e,el,d,dl, corr_ab, corr_de);
    cost[6][0] = ETX456destFrom12(a,b,d,e,f,g,al,bl,dl,el,fl,gl, corr_ab, corr_de, corr_fg);
//////////////////////////////////////////////


///////////////////////////////////////////////////
    cost[0][1] = c/cl+i/il;
    cost[1][1] = ETX5destFrom123(a,b,c,e,f,h,al,bl,cl,el,fl,hl, corr_ab,corr_bc,corr_ac,corr_abc);
    cost[2][1] = ETX_2dest12(a,al,c,cl,e,el,h,hl,i,il, corr_ac, corr_hi);
    cost[3][1] = (a/al)+(d/dl);
    cost[4][1] = ETX_2dest13(a,d,c,i,al,dl,cl,il, corr_ac);
    cost[5][1] = ETX_2dest12(c,cl,a,al,h,hl,e,el,d,dl, corr_ac, corr_de);
    cost[6][1] = ETX456destFrom12(a,c,d,e,h,i,al,cl,dl,el,hl,il, corr_ac, corr_de, corr_hi);
//////////////////////////////////////////////


///////////////////////////////////////////////////
    cost[0][2] = ETX_1dest12(b,bl,c,cl,g,gl,i,il, corr_bc);
    float x3 = cost[0][2];

    cost[1][2] = ETX5destFrom123(a,b,c,e,f,h,al,bl,cl,el,fl,hl,corr_ab,corr_bc,corr_ac,corr_abc);

    cost[2][2] = ETX56destFrom123(a,b,c,e,f,g,h,i,al,bl,cl,el,fl,gl,hl,il,x3,corr_ab,corr_bc,corr_ac,corr_abc, corr_fg, corr_hi );
    float x4 = cost[2][2];
    cost[3][2] = (a/al)+(d/dl);
    cost[4][2] = ETX46destFrom123(a,b,c,d,g,i,al,bl,cl,dl,gl,il, x3,corr_ab,corr_bc,corr_ac,corr_abc);
    cost[5][2] = ETX45destFrom123(a,b,c,d,e,f,h,al,bl,cl,dl,el,fl,hl,corr_ab,corr_bc,corr_ac,corr_abc, corr_de);
    cost[6][2] = ETX456destFrom123(a,b,c,d,e,f,g,h,i,al,bl,cl,dl,el,fl,gl,hl,il,x4,corr_ab,corr_bc,corr_ac,corr_abc, corr_fg, corr_hi);
//////////////////////////////////////////////

   vector<vector<int>> fs = {{1,2}, {1,3}, {1,2,3}};

   vector<int> ans_set = fs[0];
   float mini = cost[6][0];

   for(int i=1; i<3; i++){
    if(cost[6][i] < mini){
        mini = cost[6][i];
        ans_set = fs[i];
    }
   }

   cout << "Minimum ETT from Node 0 to {4,5,6} is " << mini << endl;
   cout << "Path = ";
   for(auto it : ans_set){
    cout << it << " ";
   }
}




