    float ettd = d/dl;
    float ette = e/el;  
    float ettf = f/fl;
    float ettg = g/gl;
    float etth = h/hl;
    float etti = i/il;
    float two56 = ETX_2dest1src(f,fl,g,gl, corr_fg);
    float three56 = ETX_2dest1src(h,hl,i,il,corr_hi);
