    float ette = e/el;  
    float ettf = f/fl;
    float etth = h/hl;
    float oneto45 = ETX_2dest1src(d,e,dl,el,corr_de);
    float n2 = 1/min({al,bl,cl});
    float numerator =
        (1 - q1 - q2 - q3 + corr_ab+corr_bc+corr_ac- corr_abc)*n2
