        + (q2 - corr_ab - corr_bc + corr_abc)*(n2+etta + ettd + ettf)
        + (q1 - corr_ab - corr_ac + corr_abc)*(n2+oneto45)

        + (corr_bc - corr_abc)*(n2+etta + ettd + min(ettf,etth))
        + (corr_ab - corr_abc)*(n2 + min(oneto45,ettd+ettf))
        + (corr_ac - corr_abc)*(n2 + min(oneto45,ettd+etth))

        + (corr_abc)*(n2 + ettd + min({ette,ettf,etth}));

