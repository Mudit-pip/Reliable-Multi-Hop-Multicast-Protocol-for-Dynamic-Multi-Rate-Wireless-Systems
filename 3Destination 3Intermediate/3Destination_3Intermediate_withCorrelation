// ETX: one source → two destinations
//used for calculating x1 in ETX_1_to_45_3intermediate
float ETX_2dest1src(float e,float f, float el, float fl, float corr_ef) {
    float q1 = 1.0/e;
    float q2 = 1.0/f;
    float etx1 = e/el;
    float etx2 = f/fl;
    float n2 = 1/min({el,fl});

    float numerator =
        (1 - q1 - q2 + corr_ef)*n2
      + (q2 - corr_ef)*(n2 + etx1)
      + (q1 - corr_ef)*(n2 + etx2)
      + corr_ef*n2;

    float denominator = q1 + q2 - corr_ef;
    return numerator / denominator;
}


// ETX from 0 → {1,3} → {4,5} with 2 intermediate nodes
//used to calculate x2 in ETX_1_to_45_3intermediate
//used to calculate ETX of reacing 4,6 form 1,2
float ETX_2dest13(float a, float d, float c, float g, 
    float al, float dl, float cl, float gl, float corr_ac) {

    float q1 = 1.0/a;
    float q3 = 1.0/c;
    float etx1 = a/al;
    float etx3 = c/cl;
    float etx4 = d/dl;
    float etx5 = g/gl;
    float n2 = 1/min({al,cl});
    float numerator =
         (1 - q1 - q3 + corr_ac)*n2
        +(q1 - corr_ac)*(n2+etx4+etx3+etx5)
        +(q3 - corr_ac)*(n2+etx5+etx1+etx4)
        +(corr_ac)*(n2+etx4+etx5);

    float denominator = q1 + q3 - corr_ac;

    return numerator/denominator;
}

// ETX from 0 → {1,2} → {4} with 2 intermediate nodes
//used to calculate x3 in ETX_1_to_45_3intermediate
//used to calculate ETX of reacing 5 form 1,2
//used to calculate ETX of reacing 6 form 1,2,3
float ETX_1dest12(
    float a, float al,
    float b, float bl,
    float d, float dl,
    float e, float el,
    float corr_ab
    ){

    float q1 = 1.0/a;
    float q2 = 1.0/b;
    float etx1 = d/dl;
    float etx2 = e/el;
    float n2 = 1/min({al,bl});
    float numerator =
         (1 - q1 - q2 + corr_ab)*n2
        +(q1 - corr_ab)*(n2+etx1)
        +(q2 - corr_ab)*(n2+etx2)
        +(corr_ab)*(n2+min(etx1,etx2));

    float denominator =  q1 + q2 - corr_ab;

    return numerator/denominator;
}

// ETX from 0 → {1,2} → {4,5} with 2 intermediate nodes
//used to calculate x4 in ETX_1_to_45_3intermediate
//used to calculate ETX of reacing 5,6 form 1,2
//used to calculate ETX of reacing 5,4 form 1,2
//used to calculate ETX of reacing 5,6 form 1,3
float ETX_2dest12(
    float a, float al,
    float b, float bl,
    float d, float dl,
    float e, float el,
    float f, float fl,
    float corr_ab, float corr_ef
    ){

    float q1 = 1.0/a;
    float q2 = 1.0/b;
    float etx14 = d/dl;
    float etx24 = e/el;
    float etx25 = f/fl;
    float etx02 = b/bl;
    float etx245 = ETX_2dest1src(e,f,el,fl,corr_ef);
    float n2 = 1/min({al,bl});
    float numerator =
         (1 - q1 - q2 + corr_ab)*n2
        +(q1 - corr_ab)*(n2+min(etx14+etx25+etx02, etx02+etx245))
        +(q2 - corr_ab)*(n2+etx245)
        +(corr_ab)*(n2+min(etx14+etx25, etx245));

    float denominator = q1 + q2 - corr_ab;

    return numerator/denominator;
}

//same for 0->{1,3}->{4,5,6}
float ETX456destFrom12(float a,float b, float d, float e, float f, float g,
    float al,float bl, float dl, float el, float fl, float gl, float corr_ab, float corr_de, float corr_fg
    ){
    float q1 = 1/a;
    float q2 = 1/b;
    float ett01 = a/al;
    float ett02 = b/bl;
    float ett14 = d/dl;
    float ett15 = e/el;
    float ett25 = f/fl;
    float ett26 = g/gl;
    float n2 = 1/min({al,bl});
    float numerator = 
        (1 - q1 - q2 + corr_ab)*n2 +
        (q1 - corr_ab)*(n2+ett02+min({ETX_2dest1src(d,e,dl,el,corr_de)+ett26, ett14+ETX_2dest1src(f,g,fl,gl,corr_fg)}))+
        (q2 - corr_ab)*(n2+ett01+min({ETX_2dest1src(d,e,dl,el,corr_de)+ett26,ett14+ETX_2dest1src(f,g,fl,gl,corr_fg)}))+
        (corr_ab)*(n2+min({ETX_2dest1src(d,e,dl,el,corr_de)+ett26, ett14+ETX_2dest1src(f,g,fl,gl,corr_fg)}));

    float denominator =  q1 + q2 - corr_ab;
    return numerator/denominator;

}

//for 0->{1,2,3}->{5}
float ETX5destFrom123(float a,float b, float c, float e, float f, float h,
    float al,float bl, float cl, float el, float fl, float hl, float corr_ab, float corr_bc,
    float corr_ac, float corr_abc
    ){
    float q1 = 1/a;
    float q2 = 1/b;
    float q3 = 1/c;
    float ett1 = a/al;  
    float ett2 = b/bl;
    float ett3 = c/cl;
    float ett4 = e/el;  
    float ett5 = f/fl;
    float ett6 = h/hl;

    float n2 = 1/min({al,bl,cl});
    float numerator =
    (1 - q1 - q2 - q3 + corr_ab+corr_bc+corr_ac- corr_abc)*n2
    + (q3 - corr_ac - corr_bc + corr_abc)*(n2+ett6)
    + (q2 - corr_ab - corr_bc + corr_abc)*(n2+ett5)
    + (q1 - corr_ab - corr_ac + corr_abc)*(n2+ett4)

    + (corr_bc - corr_abc)*(n2+min(ett5, ett6))
    + (corr_ab - corr_abc)*(n2+min(ett5, ett4))
    + (corr_ac - corr_abc)*(n2+min(ett4, ett6))

    + (corr_abc)*(n2+min({ett4, ett5, ett6}));

    // success = at least one of {2,3}
    float denominator = q1 + q2 + q3 - corr_ab - corr_bc - corr_ac + corr_abc;

    return numerator / denominator;
}

//for 0->{1,2,3}->{5,6}
float ETX56destFrom123(float a,float b, float c, float e, float f, float g, float h, float i,
    float al,float bl, float cl, float el, float fl, float gl, float hl, float il, float zerotosix,
     float corr_ab, float corr_bc,
    float corr_ac, float corr_abc, float corr_fg, float corr_hi
    ){
    float q1 = 1/a;
    float q2 = 1/b;
    float q3 = 1/c;
    float etta = a/al;  
    float ettb = b/bl;
    float ettc = c/cl;
    float ette = e/el;  
    float ettf = f/fl;
    float ettg = g/gl;
    float etth = h/hl;
    float etti = i/il;
    float two56 = ETX_2dest1src(f,fl,g,gl, corr_fg);
    float three56 = ETX_2dest1src(h,hl,i,il, corr_hi);
    float n2=1/min({al,bl,cl});



    float numerator =
        (1 - q1 - q2 - q3 + corr_ab+corr_bc+corr_ac- corr_abc)*n2
        + (q3 - corr_ac - corr_bc + corr_abc)*(n2+etth + etti)
        + (q2 - corr_ab - corr_bc + corr_abc)*(n2+ettf + ettg)
        + (q1 - corr_ab - corr_ac + corr_abc)*(n2+ette + zerotosix)

        + (corr_bc - corr_abc)*(n2+min({two56,three56,ettf+etti,ettg+etth}))
        + (corr_ab - corr_abc)*(n2+min(ette+ettg, two56))
        + (corr_ac - corr_abc)*(n2+min(ette+etti, three56))

        + (corr_abc)*(n2+min({ette+etti,ette+ettg,two56,three56,ettf+etti,ettg+etth}));

    // success = at least one of {2,3}
    float denominator = q1 + q2 + q3 - corr_ab - corr_bc - corr_ac + corr_abc;

    return numerator / denominator;
}

//for 0->{1,2,3}->{4,6}
float ETX46destFrom123(float a,float b, float c, float d, float g,float i,
    float al,float bl, float cl, float dl, float gl,float il, float zerotosix,
    float corr_ab, float corr_bc,
    float corr_ac, float corr_abc
    ){
    float q1 = 1/a;
    float q2 = 1/b;
    float q3 = 1/c;
    float etta = a/al;  
    float ettb = b/bl;
    float ettc = c/cl;
    float ettd = d/dl;
    float ettg = g/gl;
    float etti = i/il;
    float n2 = 1/min({al,bl,cl});
    float numerator =
        (1 - q1 - q2 - q3 + corr_ab+corr_bc+corr_ac- corr_abc)*n2
        + (q3 - corr_ac - corr_bc + corr_abc)*(n2+etta + ettd + etti)
        + (q2 - corr_ab - corr_bc + corr_abc)*(n2+etta + ettd + ettg)
        + (q1 - corr_ab - corr_ac + corr_abc)*(n2+ettd + zerotosix)

        + (corr_bc - corr_abc)*(n2+etta + ettd + min(etti,ettg))
        + (corr_ab - corr_abc)*(n2 + ettd+ettg)
        + (corr_ac - corr_abc)*(n2 + etti + ettd)

        + (corr_abc)*(1 + ettd + min(etti, ettg));

    // success = at least one of {2,3}
    float denominator = q1 + q2 + q3 - corr_ab - corr_bc - corr_ac + corr_abc;

    return numerator / denominator;
}


//for 0->{1,2,3}->{4,5}
float ETX45destFrom123(float a,float b, float c, float d, float e,float f, float h,
    float al,float bl, float cl, float dl, float el,float fl, float hl,
    float corr_ab, float corr_bc,
